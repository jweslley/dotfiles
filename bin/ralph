#!/bin/bash

set -e

usage() {
  echo "Usage: $(basename "$0") [-i iterations] <tasks.json>"
  exit 1
}

iterations=1
while getopts ":i:" opt; do
  case $opt in
    i) iterations=$OPTARG ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))

[[ $# -lt 1 || ! $iterations =~ ^[0-9]+$ ]] && usage

tasks="$1"
progress="$1.progress.txt"

[[ -f "$progress" ]] || printf "# Progress log\n\n## Learnings\n(Patterns discovered during implementation)\n" > "$progress"

for ((i=1; i<=$iterations; i++)); do
  result=$(claude --permission-mode acceptEdits -p "@$tasks @$progress
## STEPS

1. Read tasks from @$tasks and decide which task to work on next. This should be the one YOU decide has the highest priority, - not necessarily the first in the list.
2. Read @$progress and check the Learnings section first for patterns from previous iterations.
3. Implement that ONE task only.
4. Run tests/quality tools to verify it works.

## Critical: Only Complete if tests pass

If tests PASS, then:
  1. Update @$tasks to mark the task as complete.
  2. Commit your changes with message following Conventional commit guidelines.
  3. Append what worked to @$progress file.
  4. If, after completing the task, you notice that all work is complete, output <promise>COMPLETE</promise>.

If tests FAIL, then:
  1. Do NOT mark task as complete.
  2. Do NOT commit broken code.
  3. Append what went wrong to @$progress file (so next iteration can learn).

    ")
  echo "$result"

  if [[ "$result" == *"<promise>COMPLETE</promise>"* ]]; then
    echo "Complete, exiting."
    exit 0
  fi
done
